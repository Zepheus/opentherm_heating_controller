(version 1)

# Andiron v1.0: the only mains on the board is the four relay channels' volt-free contacts (net classes CH1..CH4,
# nets /Relays/NCn, COMn, NOn). Each channel is its own circuit: it may switch 230 V while a neighbour switches a
# boiler's low-voltage loop, so every channel is isolated from everything that is not itself.
# IEC 62368-1 reinforced at 230 V, OVC II, PD2, material group IIIb: 3.0 mm clearance, 5.0 mm creepage.
# Design floor 6.4 mm for both. Limits and their basis: tools/check/spacing_rules.json (checked by tools/check/sanity.py).

(rule "channel-isolation"
    (condition "(A.NetClass == 'CH1' && B.NetClass != 'CH1') || (A.NetClass == 'CH2' && B.NetClass != 'CH2') || (A.NetClass == 'CH3' && B.NetClass != 'CH3') || (A.NetClass == 'CH4' && B.NetClass != 'CH4')")
    (constraint clearance (min 6.4mm)))

(rule "channel-isolation-creepage"
    (condition "(A.NetClass == 'CH1' && B.NetClass != 'CH1') || (A.NetClass == 'CH2' && B.NetClass != 'CH2') || (A.NetClass == 'CH3' && B.NetClass != 'CH3') || (A.NetClass == 'CH4' && B.NetClass != 'CH4')")
    (constraint creepage (min 6.4mm)))

# NC, COM and NO of the same channel: functional insulation across an open contact; 62368-1 basic clearance at 2.5 kV is 1.5 mm.
(rule "contacts-within-channel"
    (condition "A.NetClass == B.NetClass && (A.NetClass == 'CH1' || A.NetClass == 'CH2' || A.NetClass == 'CH3' || A.NetClass == 'CH4')")
    (constraint clearance (min 2.0mm)))

(rule "mains-to-edge"
    (condition "A.NetClass == 'CH1' || A.NetClass == 'CH2' || A.NetClass == 'CH3' || A.NetClass == 'CH4'")
    (constraint edge_clearance (min 2.0mm)))

# Contact copper carries the switched load until the external 3 A fuse clears.
(rule "mains-track-width"
    (condition "A.NetClass == 'CH1' || A.NetClass == 'CH2' || A.NetClass == 'CH3' || A.NetClass == 'CH4'")
    (constraint track_width (min 2.0mm)))

# USB-C receptacle: its own pad row is 0.5 mm pitch with 0.2 mm gaps (manufacturer land pattern). The low-voltage
# 0.25 mm clearance applies everywhere else; the USB nets have their own 0.2 mm class for the escape.
(rule "usb-c-pad-row"
    (condition "A.memberOfFootprint('J1') && B.memberOfFootprint('J1')")
    (constraint clearance (min 0.15mm)))
